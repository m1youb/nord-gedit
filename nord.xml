<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="nord" name="Nord" kind="dark">
  <description>Nord color scheme for Gedit</description>

  <!-- Nord Palette -->
  <color name="nord0" value="#2E3440"/>
  <color name="nord1" value="#3B4252"/>
  <color name="nord2" value="#434C5E"/>
  <color name="nord3" value="#4C566A"/>
  <color name="nord4" value="#D8DEE9"/>
  <color name="nord5" value="#E5E9F0"/>
  <color name="nord6" value="#ECEFF4"/>
  <color name="nord7" value="#8FBCBB"/>
  <color name="nord8" value="#88C0D0"/>
  <color name="nord9" value="#81A1C1"/>
  <color name="nord10" value="#5E81AC"/>
  <color name="nord11" value="#BF616A"/>
  <color name="nord12" value="#D08770"/>
  <color name="nord13" value="#EBCB8B"/>
  <color name="nord14" value="#A3BE8C"/>
  <color name="nord15" value="#B48EAD"/>

  <!-- Global Settings -->
  <style name="text"                        foreground="nord4" background="nord0"/>
  <style name="selection"                   foreground="nord6" background="nord2"/>
  <style name="cursor"                      foreground="nord4"/>
  <style name="current-line"                background="nord1"/>
  <style name="line-numbers"                foreground="nord3" background="nord0"/>
  <style name="draw-spaces"                 foreground="nord3"/>

  <!-- Bracket Matching -->
  <style name="bracket-match"               foreground="nord8"/>
  <style name="bracket-mismatch"            foreground="nord6" background="nord11"/>

  <!-- Search Matching -->
  <style name="search-match"                foreground="nord0" background="nord13"/>

  <!-- Comments -->
  <style name="def:comment"                 foreground="nord3" italic="true"/>
  <style name="def:shebang"                 foreground="nord3" bold="true"/>

  <!-- Constants -->
  <style name="def:constant"                foreground="nord14"/>
  <style name="def:string"                  foreground="nord14"/>
  <style name="def:special-char"            foreground="nord15"/>
  <style name="def:special-constant"        foreground="nord15"/>
  <style name="def:floating-point"          foreground="nord15"/>

  <!-- Identifiers -->
  <style name="def:identifier"              foreground="nord9"/>

  <!-- Statements -->
  <style name="def:statement"               foreground="nord10" bold="true"/>

  <!-- Types -->
  <style name="def:type"                    foreground="nord7" bold="true"/>

  <!-- Markup -->
  <style name="def:emphasis"                italic="true"/>
  <style name="def:strong-emphasis"         foreground="nord13" bold="true"/>
  <style name="def:inline-code"             foreground="nord14"/>
  <style name="def:insertion"               underline="single"/>
  <style name="def:deletion"                strikethrough="true"/>
  <style name="def:link-text"               foreground="nord8"/>
  <style name="def:link-symbol"             foreground="nord9" bold="true"/>
  <style name="def:link-destination"        foreground="nord9" italic="true" underline="single"/>
  <style name="def:heading"                 foreground="nord7" bold="true"/>
  <style name="def:thematic-break"          foreground="nord14" bold="true"/>
  <style name="def:preformatted-section"    foreground="nord14"/>
  <style name="def:list-marker"             foreground="nord7" bold="true"/>

  <!-- Others -->
  <style name="def:preprocessor"            foreground="nord7"/>
  <style name="def:error"                   foreground="nord11" bold="true"/>
  <style name="def:warning"                 foreground="nord12"/>
  <style name="def:note"                    foreground="nord9" bold="true"/>
  <style name="def:net-address"             italic="true" underline="single"/>
</style-scheme>
